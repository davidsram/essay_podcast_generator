# === LLM 后端（可填多选，claude 优先） ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# === 公众号配置 ===
WECHAT_ACCOUNT=援翰写心
WECHAT_SEARCH_ENGINE=sogou

# === 视频参数 ===
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_DURATION=75
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=-8%

# === 素材目录 ===
ASSET_BG_DIR=assets/backgrounds
ASSET_MUSIC_DIR=assets/music
OUTPUT_DIR=output

# === Pexels 搜图（段落级配图；空则跳过 Pexels 链路，走 LLM 选图） ===
# https://www.pexels.com/api/ 注册 free key（5min）
# 配了 key 后每篇会多 1 次 LLM 扩词 + N 次 Pexels 搜索（带缓存）
PEXELS_API_KEY=
